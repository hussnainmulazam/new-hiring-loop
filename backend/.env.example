# Application Environment (development, staging, production)
ENVIRONMENT=development
PROJECT_NAME="Hiring Loop API"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# PostgreSQL (Supabase Connection Pooler)
# Format: postgresql://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# CORS Origins (Comma-separated string of allowed origins; wildcard '*' is forbidden when using credentials)
# Production: https://hrhiringloop.vercel.app,http://localhost:3000,http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://hrhiringloop.vercel.app

# JWT & Application Secret Key — replace with a strong random secret in production
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_strong_random_secret_here
JWT_SECRET_KEY=your_strong_random_secret_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Grok / Groq AI Configuration (High-Speed Primary Inference) ──────────────
# Supports Groq (gsk_...) or xAI Grok (xai-...) API keys
GROK_API_KEY=your_grok_or_groq_api_key_here
MODELS=openai/gpt-oss-120b

# ── OpenRouter AI Configuration ──────────────────────────────────────────────
# Obtain a free API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# OpenRouter free tier model chains (comma-separated, tried in order):
MODELS_SCREENING=nvidia/nemotron-3-ultra-550b-a55b:free,thinkingmachines/inkling-2-small:free,google/gemma-4-31b-it:free
MODELS_EXTRACTION=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-lightning:free,google/gemma-4-31b-it:free
MODELS_QUESTIONS=thinkingmachines/inkling-2-small:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free
MODELS_DRAFTS=google/gemma-4-31b-it:free,thinkingmachines/inkling-2-small:free,google/gemma-4-26b-a4b-it:free
MODELS_VISION=nvidia/nemotron-3.5-super-vl:free

# Request timeout in seconds (default: 60s)
AI_TIMEOUT_SECONDS=60.0


# ── Google OAuth2 & Workspace Integration ─────────────────────────────────────
# Registered in Google Cloud Console Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Production: https://hrhiringloopbackend.vercel.app/auth/google/callback
# Local Dev:   http://localhost:8000/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_WORKSPACE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_PROJECT_ID=hr-screening-copilot
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_JAVASCRIPT_ORIGINS=http://localhost:3000,https://hrhiringloop.vercel.app
GOOGLE_ENCRYPTION_KEY=your_fernet_encryption_key_here

# Frontend Application URL (where users are redirected after OAuth callback)
# Production: https://hrhiringloop.vercel.app
# Local Dev:   http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ── Supabase Storage Configuration ───────────────────────────────────────────
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=resumes


# ── WhatsApp Cloud API Configuration ─────────────────────────────────────────
WHATSAPP_TOKEN=your_meta_system_user_or_temporary_token
PHONE_NUMBER_ID=1476230845569922
WHATSAPP_API_VERSION=v25.0
VERIFY_TOKEN=job_tracker_whatsapp_verify_token_2026
APP_SECRET=your_meta_app_secret
WHATSAPP_DEFAULT_TEMPLATE=hello_world

# ── Redis L2 Cache Configuration (Optional — works in RAM-only mode without it) 
# REDIS_URL=redis://localhost:6379/0

# ── Pinecone Vector Service (Optional — Semantic CV Match & Similarity Only) ──
# PINECONE_API_KEY=your_pinecone_api_key_here
# PINECONE_INDEX=job-tracker-candidates
